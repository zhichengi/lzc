+"""相对路径锚定到 GCTD 仓库根（repro/gctd），不依赖启动时的 cwd。"""
+from pathlib import Path
+
+
+def repo_root() -> Path:
+    # 本文件位于 src/utils/paths.py → 上两级为仓库根
+    return Path(__file__).resolve().parents[2]
+
+
+def resolve_rel_path(p) -> Path:
+    path = Path(p).expanduser()
+    if path.is_absolute():
+        return path
+    return (repo_root() / path).resolve()
