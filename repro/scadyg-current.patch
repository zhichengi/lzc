+        if destination not in valid_destination_set:
+            raise ValueError(
+                f'positive destination {destination} is not a valid MOOC item'
+            )
+        positive_targets_by_source.setdefault(source, set()).add(destination)
+
+    candidates_by_source = {}
+    candidate_offsets = {}
+    negative_edges = []
+    for source, _ in positive_edges:
+        if source not in candidates_by_source:
+            candidates = [
+                destination
+                for destination in valid_destinations
+                if destination not in positive_targets_by_source[source]
+            ]
+            if not candidates:
+                raise ValueError(
+                    f'source {source} has no legal non-positive destination'
+                )
+            candidates_by_source[source] = candidates
+            candidate_offsets[source] = 0
+
+        candidates = candidates_by_source[source]
+        offset = candidate_offsets[source]
+        if offset % len(candidates) == 0:
+            random.shuffle(candidates)
+        negative_edges.append([source, candidates[offset % len(candidates)]])
+        candidate_offsets[source] = offset + 1
+
+    all_edges = positive_edges + negative_edges
+    labels = [1] * len(positive_edges) + [0] * len(negative_edges)
+    return all_edges, labels
+
